<%- include('partials/header.ejs') %>

<section class="music-page">

    <% if (type === "song") { %>
        <% const song = results[0]; %>
        <div class="music-detail">
            <% if (song.artworkUrl100) { %>
                <img class="music-artwork" src="<%= song.artworkUrl100.replace('100x100', '600x600') %>" alt="<%= song.trackName %>" />
            <% } %>
            <div class="music-info">
                <p class="music-kind"> SONG </p>
                <h1> <%= song.trackName || "Unknown Song" %> </h1>
                <h2> <%= song.artistName || "Unknown Artist" %> </h2>
                <% if (song.collectionName) { %>
                    <p class="music-album"> <%= song.collectionName %> </p>
                <% } %>
                <% if (song.previewUrl) { %>
                    <div class="song-player" data-preview-url="<%= song.previewUrl %>">
                        <button class="song-play-button" type="button" onclick="toggleSongPreview()" aria-label="Play preview">
                            <svg class="song-play-icon" width="22" height="22" viewBox="0 0 24 24" fill="none">
                                <path d="M8 5L19 12L8 19V5Z" fill="currentColor"/>
                            </svg>
                        </button>
                        <div class="song-player-main">
                            <div class="song-progress-container">
                                <div class="song-progress">
                                    <div class="song-progress-fill"></div>
                                </div>
                            </div>
                            <div class="song-player-bottom">
                                <span class="song-current-time">0:00</span>
                                <span class="song-total-time">0:30</span>
                            </div>
                        </div>
                        <button class="song-volume-button" type="button" onclick="toggleSongMute()" aria-label="Mute">
                            <svg class="volume-icon" width="19" height="19" viewBox="0 0 24 24" fill="none">
                                <path d="M4 9V15H8L13 19V5L8 9H4Z" fill="currentColor"/>
                                <path d="M16 9C17.2 10.2 17.2 13.8 16 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M19 6.5C21.8 9.3 21.8 14.7 19 17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </button>
                    </div>
                <% } else { %>
                    <p class="no-preview">No preview is available for this song.</p>
                <% } %>
            </div>
        </div>

<% } else if (type === "album") { %>
<!-- the first result represents the album itself or artist info, while the following results represent its tracks. -->
    <% const album = results[0]; %>
    <section class="album-header">
        <% if (album.artworkUrl100) { %>
            <img class="music-artwork" src="<%= album.artworkUrl100.replace('100x100', '600x600') %>" alt="<%= album.collectionName %>">
        <% } %>
        <div class="music-info">
            <p class="music-kind">ALBUM</p>
            <h1> <%= album.collectionName || "Unknown Album" %> </h1>
            <h2> <%= album.artistName || "Unknown Artist" %> </h2>
    <!-- turns api date, eg: '2006-11-20T08:00:00Z' to just date with new Date(album.releaseDate) & extract just year with .getFullYear() ,eg: 2006 -->
            <% if (album.releaseDate) { %>
                <p class="album-year"> <%= new Date(album.releaseDate).getFullYear() %> </p>
            <% } %>
        </div>
    </section>

    <section class="album-tracks">
        <div class="album-tracks-heading">
            <h2>Songs</h2>
    <!-- results.length - 1 bc results[0] = album, other results r songs, & results.length counts the album and all songs -->
            <span> <%= results.length - 1 %> songs </span>
        </div>
        <div class="track-list">
            <!-- results.slice(1) means give all results from index = 1 onwards,
             forEach runs the code for each item in array. -->
            <% results.slice(1).forEach((song, index) => { %>
                <article class="track-row">
                    <!-- COVER -->
                    <div class="track-artwork">
                        <% if (song.artworkUrl100) { %>
                            <img src="<%= song.artworkUrl100.replace('100x100', '200x200') %>" alt="<%= song.trackName %>">
                        <% } %>
                    </div>
                    <div class="track-info">
                        <h3> <%= song.trackName || "Unknown Song" %> </h3>
                        <p> <%= song.artistName || album.artistName || "" %>
                            <% if (song.collectionName) { %>
                                · <%= song.collectionName %>
                            <% } %>
                        </p>
                    </div>
                    <div class="track-duration">
                        <% if (song.trackTimeMillis) { %>
                            <%  const totalSeconds = Math.floor(song.trackTimeMillis / 1000);
                                const minutes = Math.floor(totalSeconds / 60);
                                const seconds = totalSeconds % 60;
                            %>
        <!-- String(seconds).padStart(2, "0") makes sure seconds always have 2 digits. eg, 3:05 instead of 3:5 -->
                            <%= minutes %>:<%= String(seconds).padStart(2, "0") %>
                        <% } else { %>
                            --:--
                        <% } %>
                    </div>
                    <button class="track-play-button" type="button"
                        onclick="event.stopPropagation(); playPreview(this, '<%= song.previewUrl || "" %>')" aria-label="Play <%= song.trackName %>">
                        <svg class="play-icon" width="18" height="18" viewBox="0 0 24 24" fill="none">
                            <path d="M8 5L19 12L8 19V5Z" fill="currentColor" />
                        </svg>
                    </button>
                    <button class="track-more-button" type="button" onclick="event.stopPropagation();" aria-label="More options" >
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                </article>
            <% }) %>
        </div>
    </section>

<% } else if (type === "artist") { %>
    <section class="artist-header">
        <div class="music-info">
            <p class="music-kind">ARTIST</p>
            <h1> <%= results[0]?.artistName || "Unknown Artist" %> </h1>
        </div>
    </section>
    <section class="album-tracks">
        <div class="album-tracks-heading">
            <h2>Songs</h2>
            <span> <%= results.length - 1 %> songs </span>
        </div>
        <div class="track-list">
            <% results.slice(1).forEach((song, index) => { %>
                <article class="track-row">
                    <!-- cover -->
                    <div class="track-artwork">
                        <% if (song.artworkUrl100) { %>
                            <img src="<%= song.artworkUrl100.replace('100x100', '200x200') %>" alt="<%= song.trackName %>">
                        <% } %>
                    </div>
                    <!-- song info -->
                    <div class="track-info">
                        <h3> <%= song.trackName || "Unknown Song" %> </h3>
                        <p> <%= song.artistName || "Unknown Artist" %>
                            <% if (song.collectionName) { %>
                                · <%= song.collectionName %>
                            <% } %>
                        </p>
                    </div>
                    <div class="track-duration">
                        <% if (song.trackTimeMillis) { %>
                            <%  const totalSeconds = Math.floor(song.trackTimeMillis / 1000);
                                const minutes = Math.floor(totalSeconds / 60);
                                const seconds = totalSeconds % 60;
                            %>
                            <%= minutes %>:<%= String(seconds).padStart(2, "0") %>
                        <% } else { %>
                            --:--
                        <% } %>
                    </div>
                    <!-- play preview -->
                    <button class="track-play-button" type="button"
                        onclick="event.stopPropagation(); playPreview(this, '<%= song.previewUrl || "" %>')" aria-label="Play <%= song.trackName %>">
                        <svg class="play-icon" width="18" height="18" viewBox="0 0 24 24" fill="none">
                            <path d="M8 5L19 12L8 19V5Z" fill="currentColor"/>
                        </svg>
                    </button>
                    <!-- MORE BUTTON -->
                    <button class="track-more-button" type="button" onclick="event.stopPropagation();" aria-label="More options">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                </article>
            <% }) %>
        </div>
    </section>
<% } %>

<%- include('partials/footer.ejs') %>